{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "--yes",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--output-dir",
        ".ci-state/browser",
        "--image-responses",
        "omit"
      ]
    }
  }
}
